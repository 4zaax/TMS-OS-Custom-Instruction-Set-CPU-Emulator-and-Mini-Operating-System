_initial:
MOV cs 60000
MOV ds 70000
MOV ss 72000
MOV esp 80000


_msg_fib_start: db "Enter your number:" 10 0
_msg_fib_overflow: db "Warning: the result is not valid since you have entered a big number"
_fib_main_loop:
    mov esi _msg_fib_start
    movb ah 0x09
    INT 21h
    call _fib_get_num
    jmp fib_end
_fib_get_num:
    push v1
    mov v1 0
_fib_get_num_loop:
    movb ah 0x08
    int 21h
    eq bl al 32
    eq cl al 10
    orb bl bl cl
    jmp _fib_get_num_end bl
    jmp _fib_is_digit
_fib_is_digit:
    subb bl al '0'
    IMUL v1 v1 10
    ADD v1 v1 bl
    jmp _fib_get_num_loop
_fib_get_num_end:
	mov v3 0
	push v1
    call _fib_eval_v1
    call _fib_num_print
    pop v1
    RET

_fib_eval_v1:
		inc v3
        eq bl v1 1

        ret bl
        push v1
        dec v1
        call _fib_eval_v1
		dec v3
        pop v2
        ADD v1 v1 v2
        ret

_fib_num_print:
    show v1
    show v2
