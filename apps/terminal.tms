_initial:
MOV cs 0
MOV ds 10000
MOV ss 13000
MOV esp 19998

# ---------------------------------------------------------------------
# TMS-OS terminal
# The first program booted by the OS (see boot.txt). It reads commands,
# keeps a command history in RAM and starts other apps with INT 21h/4Bh.
# Note: the code segment (cs 0) must stay below the data segment (ds 10000).
# ---------------------------------------------------------------------

_terminal_start:
    msg_banner: db "Welcome to TMS-OS. Type help to see the available commands." 10 0
    msg_prompt: db "tms:~$ " 0
    msg_help: db "  help          show this message" 10 "  echo <text>   print text" 10 "  apps          list the installed apps" 10 "  run <app>     start an app, e.g. run calc" 10
    msg_help2: db "  pwd           print the working directory" 10 "  hist          show the command history" 10 "  clh           clear the command history" 10
    msg_help3: db "  clear         clear the screen" 10 "  about         about this OS" 10 "  hlt           power off" 10 0
    msg_about: db "TMS-OS: a toy operating system running on a CPU emulator written in C." 10 "This terminal and every app are programs written in the TMS language." 10 0
    msg_apps: db "installed apps: calc  fact  fib  sum  reverse  arrays" 10 0
    msg_unknown: db "unknown command, type help to see the available commands" 10 0
    msg_run_usage: db "usage: run <app>   (type apps to see what is installed)" 10 0
    msg_history: db "Showing commands history: (type clh to clear ram and free up memory)" 10 0
    msg_pwd: db "Current working directory: ~/" 10 0
    msg_bye: db "Powering off..." 10 0
    app_prefix: db "./apps/" 0
    app_suffix: db ".tms" 0
    cmd_help: db "help" 0
    cmd_echo: db "echo" 0
    cmd_apps: db "apps" 0
    cmd_run: db "run" 0
    cmd_pwd: db "pwd" 0
    cmd_hist: db "hist" 0
    cmd_clh: db "clh" 0
    cmd_clear: db "clear" 0
    cmd_about: db "about" 0
    cmd_hlt: db "hlt" 0
    cmd_poweroff: db "poweroff" 0

    mov esi msg_banner
    movb ah 0x09
    int 21h
    # the command history starts at v0 and ends at hp
    mov v0 hp

_terminal_main_loop:
    mov esi msg_prompt
    movb ah 0x09
    int 21h
    mov esi hp
    call _getstr
    mov v1 esi
    call _check_user_command
    jmp _terminal_main_loop

# reads one line at hp, stored as <chars> 10 0 (hp ends after the 0)
_getstr:
    movb ah 0x08
    int 21h
    eq bl al 10
    jmp _getstr_end bl
    mov [hp] al
    inc hp
    mov [hp] 10
    jmp _getstr
_getstr_end:
    mov [hp] 10
    inc hp
    mov [hp] 0
    inc hp
    ret

# ---------------------------------------------------------------------
# command dispatcher: the line typed by the user is at v1
# ---------------------------------------------------------------------
_check_user_command:
    movb bh [v1]
    eq bl bh 10
    ret bl

    mov edi cmd_help
    call _match_cmd
    jmp _help_handler bl

    mov edi cmd_echo
    call _match_cmd
    jmp _echo_handler bl

    mov edi cmd_apps
    call _match_cmd
    jmp _apps_handler bl

    mov edi cmd_run
    call _match_cmd
    jmp _run_handler bl

    mov edi cmd_pwd
    call _match_cmd
    jmp _pwd_handler bl

    mov edi cmd_hist
    call _match_cmd
    jmp _history_handler bl

    mov edi cmd_clh
    call _match_cmd
    jmp _clh_handler bl

    mov edi cmd_clear
    call _match_cmd
    jmp _clear_handler bl

    mov edi cmd_about
    call _match_cmd
    jmp _about_handler bl

    mov edi cmd_hlt
    call _match_cmd
    jmp _halt_handler bl

    mov edi cmd_poweroff
    call _match_cmd
    jmp _halt_handler bl

    mov esi msg_unknown
    movb ah 0x09
    int 21h
    ret

# compares the first word at v1 with the 0-terminated string at edi
# sets bl to 1 when they match (the word must end with a space, newline or 0)
_match_cmd:
    mov v2 v1
    mov v3 edi
_match_cmd_loop:
    movb cl [v3]
    eq bl cl 0
    jmp _match_cmd_word_end bl
    movb bh [v2]
    neq bl bh cl
    jmp _match_cmd_fail bl
    inc v2
    inc v3
    jmp _match_cmd_loop
_match_cmd_word_end:
    movb bh [v2]
    eq bl bh 32
    ret bl
    eq bl bh 10
    ret bl
    eq bl bh 0
    ret bl
_match_cmd_fail:
    movb bl 0
    ret

# moves esi forward past spaces
_skip_spaces:
    movb bh [esi]
    neq bl bh 32
    ret bl
    inc esi
    jmp _skip_spaces

# copies the 0-terminated string at v4 to edi
_append_str:
    movb bh [v4]
    eq bl bh 0
    ret bl
    movb [edi] bh
    inc v4
    inc edi
    jmp _append_str

# copies the word at esi (up to a space, newline or 0) to edi
_append_word:
    movb bh [esi]
    eq bl bh 32
    ret bl
    eq bl bh 10
    ret bl
    eq bl bh 0
    ret bl
    movb [edi] bh
    inc esi
    inc edi
    jmp _append_word

# ---------------------------------------------------------------------
# command handlers
# ---------------------------------------------------------------------
_help_handler:
    mov esi msg_help
    movb ah 0x09
    int 21h
    ret

_echo_handler:
    add esi v1 4
    call _skip_spaces
    movb ah 0x09
    int 21h
    ret

_apps_handler:
    mov esi msg_apps
    movb ah 0x09
    int 21h
    ret

_about_handler:
    mov esi msg_about
    movb ah 0x09
    int 21h
    ret

_pwd_handler:
    mov esi msg_pwd
    movb ah 0x09
    int 21h
    ret

_clear_handler:
    movb ah 0x00
    int 10h
    ret

_halt_handler:
    mov esi msg_bye
    movb ah 0x09
    int 21h
    hlt

# run <app>: builds the path ./apps/<app>.tms after the history and asks
# the OS to load and execute it (INT 21h, AH=4Bh). The OS saves our
# registers and labels and gives control back when the app halts.
_run_handler:
    add esi v1 3
    call _skip_spaces
    movb bh [esi]
    eq bl bh 10
    jmp _run_usage bl
    mov edi hp
    mov v4 app_prefix
    call _append_str
    call _append_word
    mov v4 app_suffix
    call _append_str
    movb [edi] 0
    mov esi hp
    movb ah 0x4B
    int 21h
    ret
_run_usage:
    mov esi msg_run_usage
    movb ah 0x09
    int 21h
    ret

_history_handler:
    push esi
    mov esi msg_history
    movb ah 0x09
    int 21h

    push v1
    pushb bh
    pushb bl
    mov v1 v0

    _history_handler_main_loop:
        eq bh v1 hp
        jmp _history_handler_end bh

        movb dl [v1]
        neq bl dl 0
        jmp _history_handler_putc bl
        inc v1
        jmp _history_handler_main_loop

    _history_handler_putc:
        movb ah 0x02
        int 21h
        inc v1
        jmp _history_handler_main_loop

    _history_handler_end:
        popb bl
        popb bh
        pop v1
        pop esi
        ret

_clh_handler:
    mov hp v0
    ret
